# Safety: a loop. `sum` and `i` are written in .body and read again on
# the next iteration, so they are live out of the block that defines them.
@main(n: int) {
  i: int = const 0;
  sum: int = const 0;
  one: int = const 1;
.loop:
  cond: bool = lt i n;
  br cond .body .done;
.body:
  sum: int = add sum i;
  i: int = add i one;
  jmp .loop;
.done:
  print sum;
}
